{
  "name": "azur-lane-archive-cn",
  "version": "1.3.4",
  "description": "碧蓝航线国服桌面舰船图鉴与收藏管理工具",
  "main": "dist-electron/main.cjs",
  "author": "Azur Lane Archive Community Tool",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sync:data": "node scripts/sync-data.mjs",
    "sync:wiki": "node scripts/sync-wiki-module.mjs all data/wiki.json",
    "typecheck": "vue-tsc --noEmit",
    "build:web": "vite build",
    "build:offline": "npm run typecheck && npm run build:web && electron-builder --win nsis portable",
    "build": "npm run sync:data && npm run typecheck && npm run build:web && electron-builder --win nsis portable",
    "build:dir": "npm run sync:data && npm run typecheck && npm run build:web && electron-builder --win dir",
    "test": "vitest run"
  },
  "dependencies": {
    "@vueuse/core": "^13.9.0",
    "lucide-vue-next": "^0.468.0",
    "sql.js": "^1.13.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12",
    "typescript": "^5.7.2",
    "vite": "^6.0.1",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  },
  "build": {
    "appId": "cn.azurlane.archive.desktop",
    "productName": "碧蓝航线舰船图鉴",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "data/**/*",
      "scripts/**/*",
      "build/icon.png",
      "node_modules/sql.js/dist/sql-wasm.js",
      "node_modules/sql.js/dist/sql-wasm.wasm",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "artifactName": "${productName}-${version}-${arch}-安装版.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "碧蓝航线舰船图鉴"
    },
    "portable": {
      "artifactName": "碧蓝航线舰船图鉴-${version}-绿色版.${ext}"
    }
  }
}
